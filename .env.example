# Copy to .env and put your key into KEITARO_API_KEY. docker compose reads this file.

# Keitaro Admin API. The key is behind the "API ключ" button at the top of the Keitaro admin.
KEITARO_URL=https://keitaro-for-tests.etolegko.com
KEITARO_API_KEY=

# Every campaign name gets this prefix (the task asks for test_<surname>_)
CAMPAIGN_PREFIX=test_karaf_

LOG_LEVEL=INFO

# Ports on your machine
APP_PORT=8000
POSTGRES_PORT=5432

# Only for running the backend outside Docker (make dev-backend);
# inside compose the app uses the db service
DATABASE_URL=postgresql+asyncpg://wrapper:wrapper@127.0.0.1:5432/wrapper
